# KODEWAR Talent Frontend Environment Variables
# Copy this file to .env or .env.local for local overrides

# Application Name
VITE_APP_NAME=KODEWAR

# Backend API Base URL
# Development: http://localhost:5000/api
# Production (Render/Fly/Railway): https://your-backend-api.onrender.com/api
VITE_API_URL=http://localhost:5000/api

# Google OAuth Client ID
# Public browser client ID only. Never put Google client secrets or service-role keys in VITE_ variables.
VITE_GOOGLE_CLIENT_ID=
