# ==================================================
# KODEWAR BACKEND — ENVIRONMENT CONFIGURATION TEMPLATE
# Copy to .env and configure for your environment
# ==================================================

# Server Configuration
PORT=5000
NODE_ENV=development

# CORS & Frontend Origins (comma-separated allowed origins)
# Production MUST include: https://kodewar.com,https://www.kodewar.com
FRONTEND_URL=https://kodewar.com
CORS_ORIGIN=https://kodewar.com,https://www.kodewar.com,http://localhost:5173,http://localhost:3000

# Authentication & Security
# IN PRODUCTION: JWT_SECRET MUST be set to a cryptographically secure random string (minimum 32 characters)
JWT_SECRET=your_jwt_secret_minimum_32_characters_here

# Initial Admin Account Setup (First Run Only)
ADMIN_EMAIL=admin@kodewar.com
ADMIN_INITIAL_PASSWORD=SetSecureAdminPasswordHere2026!

# Database Configuration
# Leave empty for local development to use zero-config persistent JSON storage (backend/data/kodewar.db.json)
# IN PRODUCTION: Provide a PostgreSQL connection string from Supabase or another managed Postgres host
DATABASE_URL=
PGSSLMODE=require

# Resume File Storage Provider
# Options: 'local' (development disk) | 'supabase' (private Supabase Storage bucket)
STORAGE_PROVIDER=local

# Supabase Storage (required in production when STORAGE_PROVIDER=supabase; keep the bucket private)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=resumes

# Google OAuth 2.0 (Server-only credentials)
# GOOGLE_CLIENT_SECRET is strictly backend-only. NEVER expose it in frontend VITE_ variables.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Password Reset Mode
# Options: 'development' (local mock token) | 'email' (production email delivery integration)
PASSWORD_RESET_MODE=development
