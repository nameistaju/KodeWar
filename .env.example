# KODEWAR Technologies — Root Environment Overview
# This project separates Frontend and Backend configurations cleanly.
# Refer to the respective directory .env.example files for detailed parameters.

# ==============================================================================
# FRONTEND CONFIGURATION (frontend/.env)
# ==============================================================================
# VITE_APP_NAME=KODEWAR
# VITE_API_URL=http://localhost:5000/api
# VITE_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# ==============================================================================
# BACKEND CONFIGURATION (backend/.env)
# ==============================================================================
# PORT=5000
# NODE_ENV=development
# JWT_SECRET=your-64-character-cryptographically-secure-hex-string
# ADMIN_EMAIL=admin@kodewar.com
# ADMIN_INITIAL_PASSWORD=replace-with-a-one-time-strong-admin-password
# CORS_ORIGIN=http://localhost:3000,http://localhost:5173
# DATABASE_URL=postgresql://user:password@db.supabase.co:5432/postgres?sslmode=require
# PGSSLMODE=require
# STORAGE_PROVIDER=local
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=server-only-service-role-key
# SUPABASE_STORAGE_BUCKET=resumes
# GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=your-google-client-secret
# PASSWORD_RESET_MODE=development
